# OilTrace configuration — PLACEHOLDERS ONLY. Never commit real credentials.
# Copy to .env and fill locally; .env is gitignored and never auto-created from this file.

APP_MODE=development
# development | sih_demo | staging | production

DATABASE_URL=postgresql+psycopg2://oiltrace:oiltrace@localhost:5432/oiltrace

CMEMS_USERNAME=
CMEMS_PASSWORD=
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
GFW_API_TOKEN=
# Optional API key: when set, mutating/data endpoints require X-API-Key header.
OILTRACE_API_KEY=

# Public AWS Sentinel-1 discovery requires no AWS credential.
AWS_SENTINEL1_STAC_URL=https://earth-search.aws.element84.com/v1
AWS_SENTINEL1_COLLECTION=sentinel-1-grd
AWS_SENTINEL1_BUCKET=sentinel-s1-l1c
AWS_SENTINEL1_REGION=eu-central-1

# Live APIs are attempted first. Synthetic fallback is development-only and
# never silently mixed with real data (see APP_MODE + data_mode).
# DEPRECATED: ALLOW_LIVE_FALLBACK/REALTIME_DATA_ONLY/REQUIRE_REAL_MODEL are
# kept for compatibility; APP_MODE is authoritative (see config validation).
ALLOW_LIVE_FALLBACK=false
REALTIME_DATA_ONLY=true
REQUIRE_REAL_MODEL=true

AIS_SEARCH_RADIUS_KM=20
AIS_TIME_PAD_HOURS=6

FAST_PROTOTYPE_MODE=true
PIPELINE_TARGET_SECONDS=30
DEFAULT_LOOKBACK_HOURS=24
DRIFT_PARTICLES=80
DRIFT_OUTPUT_INTERVAL_HOURS=1
DRIFT_ENV_PAD_DEG=0.75
INFERENCE_MAX_PIXELS=2000000
INFERENCE_TILE_SIZE=256
INFERENCE_TILE_OVERLAP=32
MAX_UPLOAD_BYTES=1073741824

# Netlify frontend -> Render backend
# Set this only in the Netlify environment, not in the backend .env.
# VITE_API_BASE=https://YOUR-RENDER-BACKEND.onrender.com
# Optional: point the map at a production-grade style (MapTiler, Stadia,
# self-hosted, etc.) instead of the built-in OSM raster fallback.
# VITE_MAP_STYLE=https://api.maptiler.com/maps/streets/style.json?key=YOUR_KEY

JOB_MAX_ATTEMPTS=3
JOB_RETENTION_DAYS=30
WORKER_CONCURRENCY=2
JOB_TIMEOUT_S=1800
ENV_CACHE_TTL_HOURS=168
ENV_FRESH_HOURS=72
DRIFT_SEED=20260905
DRIFT_QUALITY_MIN=60

# Comma-separated frontend origins. Never use * outside local development.
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
SSRF_ALLOWED_HOSTS=earth-search.aws.element84.com,sentinel-s1-l1c.s3.eu-central-1.amazonaws.com
