# OilTrace SIH demo configuration — placeholders only, never commit real secrets.
# Copy to .env when demonstrating. Demo rows are labeled SCENARIO in the API,
# database (spills.data_mode), UI banners, and PDF reports.

APP_MODE=sih_demo

# Demo runs against its own database file so scenario rows never mix with
# production investigations. Point this at a scratch database.
DATABASE_URL=sqlite:///data/oiltrace_demo.db

CMEMS_USERNAME=
CMEMS_PASSWORD=
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
GFW_API_TOKEN=
OILTRACE_API_KEY=

AWS_SENTINEL1_STAC_URL=https://earth-search.aws.element84.com/v1
AWS_SENTINEL1_COLLECTION=sentinel-1-grd
AWS_SENTINEL1_BUCKET=sentinel-s1-l1c
AWS_SENTINEL1_REGION=eu-central-1

# Deterministic demo: fixed seeds, bounded lookback, prototype timestep shown in UI.
DRIFT_SEED=20260905
DEFAULT_LOOKBACK_HOURS=24
DRIFT_PARTICLES=80
DRIFT_OUTPUT_INTERVAL_HOURS=1
FAST_PROTOTYPE_MODE=true
PIPELINE_TARGET_SECONDS=30
AIS_SEARCH_RADIUS_KM=20
AIS_TIME_PAD_HOURS=6
INFERENCE_MAX_PIXELS=2000000
INFERENCE_TILE_SIZE=256
INFERENCE_TILE_OVERLAP=32
MAX_UPLOAD_BYTES=1073741824
JOB_MAX_ATTEMPTS=3
JOB_RETENTION_DAYS=30
WORKER_CONCURRENCY=2
JOB_TIMEOUT_S=1800
ENV_CACHE_TTL_HOURS=168
ENV_FRESH_HOURS=72
DRIFT_QUALITY_MIN=60
TRACK_GAP_HOURS=6
AIS_STALE_HOURS=72

CORS_ORIGINS=http://localhost:8000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
SSRF_ALLOWED_HOSTS=earth-search.aws.element84.com,sentinel-s1-l1c.s3.eu-central-1.amazonaws.com
